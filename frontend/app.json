{
  "expo": {
    "name": "EVA Boat Mat Digitizer",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.tappodxf.xxg6mq",
      "infoPlist": {
        "NSCameraUsageDescription": "Scatta foto della dima delimitata dal nastro",
        "NSPhotoLibraryUsageDescription": "Carica foto della dima dalla galleria",
        "NSMotionUsageDescription": "Verifica che il telefono sia parallelo al piano"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.tappodxf.xxg6mq",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scatta foto della dima delimitata dal nastro"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Carica foto della dima dalla galleria"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
